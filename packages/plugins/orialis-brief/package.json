{
  "name": "@paperclipai/orialis-brief",
  "version": "0.1.0",
  "description": "Orialis project brief UI preview plugin",
  "type": "module",
  "private": true,
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "tsc && node ./scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "workspace:1.0.0",
    "@paperclipai/shared": "workspace:0.3.1"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.18",
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
