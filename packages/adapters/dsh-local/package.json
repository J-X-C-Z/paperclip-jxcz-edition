{
  "name": "@paperclipai/adapter-dsh-local",
  "version": "0.3.1",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
      "./server": { "types": "./dist/server/index.d.ts", "import": "./dist/server/index.js" }
    }
  },
  "files": ["dist"],
  "scripts": { "build": "tsc", "clean": "rm -rf dist", "typecheck": "tsc --noEmit" },
  "dependencies": { "@paperclipai/adapter-utils": "workspace:*" },
  "devDependencies": { "@types/node": "^24.13.3", "typescript": "^7.0.2" },
  "engines": { "node": ">=24.11.0" }
}
